 mn>1</mn>\n  <mo>\,</mo>\n  <mn>1</mn>\n  <mo stretchy=&quot\;false&quot\;
 >)</mo>\n</math>"></td>\n<td style="padding: 10px\; text-align: center\; b
 order: 1px solid #cccccc\;"><img class="equation_image" title="Y\\mid X=x\
 \sim N(2+3x\,1)" src="https://um6p.instructure.com/equation_images/Y%255Cm
