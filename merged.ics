 mo>\n  <mi>N</mi>\n  <mo stretchy=&quot\;false&quot\;>(</mo>\n  <mn>2</mn>
 \n  <mo>+</mo>\n  <mn>3</mn>\n  <mi>x</mi>\n  <mo>\,</mo>\n  <mn>1</mn>\n 
  <mo stretchy=&quot\;false&quot\;>)</mo>\n</math>"></td>\n</tr>\n<tr>\n<td
  style="padding: 10px\; border: 1px solid #cccccc\;"><strong>DGP 2</strong
